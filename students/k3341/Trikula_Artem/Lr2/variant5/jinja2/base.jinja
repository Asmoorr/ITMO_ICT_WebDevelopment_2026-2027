<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Научные конференции{% endblock %}</title>
<link rel="stylesheet" href="{{ static('conferences/site.css') }}"></head>
<body><a class="skip" href="#content">Перейти к содержимому</a>
<header class="site-header"><div class="container header-inner"><a class="brand" href="{{ url('conferences:catalog') }}"><span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 16H5V10h14v10ZM5 8V6h14v2H5Zm2 4h5v5H7v-5Z"/></svg></span>Конференции</a>
<nav aria-label="Основная навигация"><a href="{{ url('conferences:catalog') }}"{% if request.path == url('conferences:catalog') %} aria-current="page"{% endif %}>Каталог</a>
{% if request.user.is_authenticated %}<a href="{{ url('conferences:my_registrations') }}">Мои заявки</a>{% endif %}
{% if request.user.has_perm('conferences.view_registration') %}<a href="{{ url('conferences:participants') }}">Участники и результаты</a>{% endif %}
{% if request.user.is_staff %}<a href="{{ url('admin:index') }}">Admin</a>{% endif %}</nav>
<div class="account-nav">{% if request.user.is_authenticated %}<span class="user-name">{{ request.user.get_full_name() or request.user.username }}</span><form method="post" action="{{ url('logout') }}">{{ csrf_input }}<button class="text-button">Выйти</button></form>{% else %}<a href="{{ url('login') }}">Войти</a><a class="button compact" href="{{ url('accounts:signup') }}">Регистрация</a>{% endif %}</div></div></header>
<main class="container" id="content">{% for message in messages(request) %}<div class="notice" role="status">{{ message }}</div>{% endfor %}{% block content %}{% endblock %}</main>
</body></html>
