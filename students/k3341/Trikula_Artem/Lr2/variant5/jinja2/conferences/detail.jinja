{% extends 'base.jinja' %}{% from 'fields.jinja' import field_row, form_errors %}
{% block title %}{{ conference.title }} · Конференции{% endblock %}
{% block content %}<a class="back-link" href="{{ url('conferences:catalog') }}">Все конференции</a><div class="detail-heading"><div class="tags">{% for topic in conference.topics.all() %}<span class="tag">{{ topic.name }}</span>{% endfor %}</div><h1>{{ conference.title }}</h1><p class="lead">{{ conference.venue.city }} · {{ conference.start_date|date }} — {{ conference.end_date|date }}</p></div>
<div class="detail-layout"><div><section class="content-section"><h2>О конференции</h2><p class="prose">{{ conference.description }}</p></section><section class="content-section"><h2>Условия участия</h2><p class="prose">{{ conference.participation_terms }}</p></section><section class="content-section"><h2>Место проведения</h2><h3>{{ conference.venue.name }}</h3><p>{{ conference.venue.address }}</p><p class="prose muted">{{ conference.venue.description }}</p></section></div>
<aside class="surface event-sidebar"><span class="phase {% if conference.finished %}finished{% endif %}">{{ conference.phase }}</span><h2>Участие с докладом</h2><p>Заявок: {{ participant_count }}</p>{% if conference.registration_open %}{% if registration %}<p>Ваша заявка уже подана.</p><a class="button full-width" href="{{ url('conferences:registration_edit', args=[registration.pk]) }}">Редактировать заявку</a>{% elif request.user.is_authenticated %}<a class="button full-width" href="{{ url('conferences:registration_create', args=[conference.pk]) }}">Подать заявку</a>{% else %}<a class="button full-width" href="{{ url('login') }}?next={{ url('conferences:registration_create', args=[conference.pk])|urlencode }}">Войти и подать заявку</a>{% endif %}<p class="help">Приём заявок закрывается в день начала конференции.</p>{% else %}<p>Приём заявок завершён.</p>{% if registration %}<p class="result-label">Ваш результат</p><p>{{ registration.get_result_display() }}</p>{% endif %}{% endif %}
{% if request.user.has_perm('conferences.change_conference') %}<hr><a href="{{ url('conferences:conference_edit', args=[conference.pk]) }}">Редактировать конференцию</a>{% endif %}{% if request.user.has_perm('conferences.view_registration') %}<p><a href="{{ url('conferences:participants') }}?conference={{ conference.pk }}">Участники и результаты</a></p>{% endif %}</aside></div>
<section class="reviews-section"><div class="section-heading"><div><h2>Отзывы участников</h2>{% if average_rating is not none %}<p class="muted">Средняя оценка {{ '%.1f'|format(average_rating) }}/10</p>{% endif %}</div>{% if current_review %}<a class="button secondary" href="{{ url('conferences:review_edit', args=[current_review.pk]) }}">Редактировать мой отзыв</a>{% elif conference.finished and registration %}<a class="button" href="{{ url('conferences:review_create', args=[conference.pk]) }}">Оставить отзыв</a>{% endif %}</div>
<form method="get" class="surface inline-filters">{{ form_errors(review_filters) }}{% for field in review_filters %}{{ field_row(field) }}{% endfor %}<button>Показать отзывы</button><a href="{{ conference.get_absolute_url() }}">Сбросить</a></form>
{% for review in page %}<article class="review surface"><div class="review-header"><strong>{{ review.author }}</strong><span class="rating">{{ review.rating }}/10</span></div><p class="help">Конференция {{ review.conference_start|date }} — {{ review.conference_end|date }}</p><p class="prose">{{ review.text }}</p></article>{% else %}<p class="muted">Отзывов пока нет. Участники смогут поделиться впечатлениями после окончания конференции.</p>{% endfor %}{% include 'pagination.jinja' %}</section>{% endblock %}
