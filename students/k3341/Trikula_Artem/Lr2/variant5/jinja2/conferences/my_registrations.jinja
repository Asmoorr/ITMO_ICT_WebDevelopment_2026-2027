{% extends 'base.jinja' %}{% from 'fields.jinja' import field_row, form_errors %}{% block title %}Мои заявки · Конференции{% endblock %}
{% block content %}<div class="page-heading"><div><h1>Мои заявки</h1><p class="lead">Ваши доклады и результаты выступлений.</p></div><a class="button secondary" href="{{ url('conferences:catalog') }}">Найти конференцию</a></div>
<form method="get" class="surface inline-filters">{{ form_errors(form) }}{% for field in form %}{{ field_row(field) }}{% endfor %}<button>Показать</button><a href="{{ url('conferences:my_registrations') }}">Сбросить</a></form>
{% for registration in page %}<article class="surface registration"><div class="section-heading"><div><p class="muted"><a href="{{ registration.conference.get_absolute_url() }}">{{ registration.conference.title }}</a></p><h2>{{ registration.title }}</h2></div><span class="tag result-{{ registration.result }}">{{ registration.get_result_display() }}</span></div><p class="prose">{{ registration.abstract }}</p><p class="muted">{{ registration.conference.start_date|date }} — {{ registration.conference.end_date|date }} · {{ registration.conference.venue.city }}</p>{% if registration.conference.registration_open %}<div class="actions"><a href="{{ url('conferences:registration_edit', args=[registration.pk]) }}">Редактировать</a><a class="danger-link" href="{{ url('conferences:registration_delete', args=[registration.pk]) }}">Отменить заявку</a></div>{% else %}<p class="help">Конференция началась — изменение заявки закрыто.</p>{% endif %}</article>{% else %}<div class="surface empty"><h2>Заявок по выбранным условиям нет</h2><p>Выберите конференцию и расскажите о своём исследовании.</p><a class="button" href="{{ url('conferences:catalog') }}">Посмотреть конференции</a></div>{% endfor %}{% include 'pagination.jinja' %}{% endblock %}
