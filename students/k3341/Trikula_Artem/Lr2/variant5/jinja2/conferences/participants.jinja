{% extends 'base.jinja' %}{% from 'fields.jinja' import field_row, form_errors %}{% block title %}Участники и результаты · Конференции{% endblock %}
{% block content %}<div class="page-heading"><div><h1>Участники и результаты</h1><p class="lead">Заявки авторов по конференциям и решения о публикации.</p></div></div><form method="get" class="surface inline-filters">{{ form_errors(form) }}{% for field in form %}{{ field_row(field) }}{% endfor %}<button>Показать</button><a href="{{ url('conferences:participants') }}">Сбросить</a></form>
<div class="table-scroll surface"><table><caption>Заявок: {{ page.paginator.count }}</caption><thead><tr><th>Конференция</th><th>Участник</th><th>Доклад</th><th>Результат</th><th>Действие</th></tr></thead><tbody>{% for registration in page %}<tr><td><a href="{{ registration.conference.get_absolute_url() }}">{{ registration.conference.title }}</a></td><td>{{ registration.author }}<span class="table-note">{{ registration.author.organization }}</span></td><td>{{ registration.title }}</td><td>{{ registration.get_result_display() }}</td><td>{% if request.user.has_perm('conferences.set_publication_result') %}<a href="{{ url('conferences:publication_result', args=[registration.pk]) }}">Указать результат</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5">Заявок по выбранным условиям не найдено.</td></tr>{% endfor %}</tbody></table></div>{% include 'pagination.jinja' %}{% endblock %}
