{% if page.has_other_pages() %}<nav class="pagination" aria-label="Страницы">{% if page.has_previous() %}<a class="button secondary compact" href="{{ page_url(request, page.previous_page_number()) }}">Предыдущая</a>{% endif %}<span>Страница {{ page.number }} из {{ page.paginator.num_pages }}</span>{% if page.has_next() %}<a class="button secondary compact" href="{{ page_url(request, page.next_page_number()) }}">Следующая</a>{% endif %}</nav>{% endif %}
